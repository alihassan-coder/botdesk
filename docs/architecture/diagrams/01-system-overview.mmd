flowchart TB
  subgraph People["People"]
    U1["Web app (Next.js)<br/>desktop and mobile later"]
  end
  subgraph API["API process"]
    R["apps/api: FastAPI, /api/v1<br/>Routes → Controllers → Services<br/>sign-in · chats · approvals"]
    SSE["Live stream (SSE)<br/>one per person, resumable"]
  end
  DB[("Postgres: the only required service<br/>app data · job queue · run checkpoints<br/>events · memories (pgvector)")]
  subgraph WORKER["Worker process"]
    RUN["Run engine (same code, second entrypoint)<br/>one LangGraph graph per run"]
    SCHED["Scheduler<br/>routines · triggers · expiry sweeps"]
    PIPE["Tool pipeline<br/>policy → approval → execute → audit"]
    REG["Plugin registry"]
  end
  subgraph PLUG["Plugins"]
    P0["Gmail (built-in)"]
    P3["Remote MCP servers"]
    P1["HTTP plugins<br/>(no code, later)"]
  end
  LLM["Model providers<br/>Anthropic · OpenAI · any"]
  U1 -- "cookie or Bearer token" --> R
  SSE -- "live updates" --> U1
  R -- "save message or decision<br/>+ enqueue a job (one transaction)" --> DB
  DB -- "events" --> SSE
  DB -- "jobs" --> RUN
  SCHED -- "enqueue jobs" --> DB
  RUN -- "checkpoints · steps · events" --> DB
  RUN --> PIPE --> REG
  RUN -- "LangChain" --> LLM
  REG --> P0
  REG --> P3
  REG --> P1
