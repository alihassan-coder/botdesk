# BotDesk self-hosting settings, for deploy/docker-compose.yml.
#   cp deploy/.env.example deploy/.env    then fill in the REQUIRED lines.
# Never commit deploy/.env. Every API setting is explained in apps/api/.env.example; this file
# has only what a self-hoster usually sets. Guide: docs/self-hosting/README.md

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------

# Encrypts the model provider keys your organizations save. At least 32 characters. Generate:
#   openssl rand -base64 48
#   (or: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
# Keep it safe and keep it the same: lose it and saved model keys must be added again.
# The API refuses to start in production without it.
SECRET_KEY=

# Password for the bundled Postgres. Letters and digits only (it goes inside a URL). Generate:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Where people open BotDesk
# ---------------------------------------------------------------------------------------------

# The address of the API as people's BROWSERS reach it (not the address inside Docker).
# Baked into the web app when its image is built: after changing it, run `up -d --build`.
#   Same machine, no proxy:              http://localhost:8000
#   Behind a reverse proxy, one domain:  https://botdesk.example.com   (the proxy sends /api/* to the API)
NEXT_PUBLIC_API_URL=http://localhost:8000

# The address of the web app as people's browsers reach it. Both must match it exactly
# (scheme, host and port, no trailing slash): WEB_ORIGINS lets that page call the API with its
# sign-in cookie, WEB_APP_URL is where invite and password-reset links point.
WEB_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# production (default): SECRET_KEY required, sign-in cookies are Secure (sent over HTTPS only;
# browsers make an exception for http://localhost), no /api/docs.
# Testing over plain http on your LAN (http://192.168.x.x:3000)? Browsers drop Secure cookies
# there, so sign-in won't stick. Set development for that test only: cookies lose Secure and
# /api/docs is public. Never use development on an install other people reach.
ENVIRONMENT=production

# Which host addresses the ports listen on. 127.0.0.1 = this machine only (use with a reverse
# proxy on the same machine). 0.0.0.0 = every network interface (LAN testing).
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8000

# ---------------------------------------------------------------------------------------------
# Your own database instead of the bundled one (optional)
# ---------------------------------------------------------------------------------------------
# Neon or any Postgres 15+ with the pgvector extension available. See the guide: also remove
# the postgres service from docker-compose.yml. On Neon, keep ?sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/botdesk?sslmode=require
# The direct (unpooled) address, for run checkpoints and memory. Empty = DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.neon.tech/botdesk?sslmode=require

# ---------------------------------------------------------------------------------------------
# Models (optional)
# ---------------------------------------------------------------------------------------------
# Organizations add their own keys in Settings -> Models & keys; those come first. These are an
# instance-wide fallback. With neither, bots answer with a stand-in reply.
DEFAULT_MODEL_ID=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Allow custom model servers on private addresses (e.g. Ollama or vLLM on your own network).
# Off by default: it would let an org admin make the API call internal services.
ALLOW_PRIVATE_MODEL_URLS=false

# ---------------------------------------------------------------------------------------------
# Memory (optional)
# ---------------------------------------------------------------------------------------------
# Bots remember facts across chats (mem0 on pgvector, in the same database).
# Needs OPENAI_API_KEY above (mem0 uses OpenAI to pick facts and embed them).
MEMORY_ENABLED=false

# ---------------------------------------------------------------------------------------------
# Email (optional, but needed for invites and password resets to reach people)
# ---------------------------------------------------------------------------------------------
# Brevo transactional API. Leave the key empty and no email is sent: the invite dialog still
# shows a link to copy, but password resets can't reach anyone (the log notes "Email not sent").
# Key: Brevo -> SMTP & API -> API Keys. Sender: Brevo -> Senders & Domains (verify it).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=BotDesk

# ---------------------------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------------------------
# Built-in plugins to load. "demo" has fake tools (notes, a fake outbox) to try approvals.
PLUGINS=demo
