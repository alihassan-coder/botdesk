{
  "name": "botdesk",
  "private": true,
  "description": "BotDesk: open-source AI assistant for teams. Any model, shared memory, agents you can @mention.",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --ui stream",
    "dev:web": "pnpm --filter @botdesk/web dev",
    "dev:api": "pnpm --filter @botdesk/api dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @botdesk/web build",
    "start:web": "pnpm --filter @botdesk/web start",
    "start:api": "pnpm --filter @botdesk/api start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:web": "pnpm --filter @botdesk/web test",
    "test:api": "pnpm --filter @botdesk/api test",
    "test:e2e": "pnpm --filter @botdesk/web test:e2e",
    "check": "turbo run typecheck lint test",
    "db:migrate": "pnpm --filter @botdesk/api db:migrate",
    "db:seed": "pnpm --filter @botdesk/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
