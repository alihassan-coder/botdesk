flowchart TD
  START(["Run starts<br/>message · routine · trigger · handoff"]) --> CTX["load_context<br/>instructions + recent messages<br/>+ memories + allowed tools"]
  CTX --> MODEL["call_model<br/>streams tokens to the chat"]
  MODEL --> ROUTE{"Did the model<br/>ask for a tool?"}
  ROUTE -- "no: final answer" --> SAVE["save_reply<br/>message + run steps"]
  ROUTE -- "yes" --> TOOLS["tool_pipeline<br/>one tool call at a time"]
  TOOLS --> GATE{"Policy decision"}
  GATE -- "auto" --> EXEC["execute the tool"]
  GATE -- "ask" --> WAIT["interrupt()<br/>run sleeps in Postgres<br/>approval card shown"]
  WAIT -- "Command(resume=decision)" --> DEC{"Approved?"}
  DEC -- "yes, maybe edited" --> EXEC
  DEC -- "no" --> DENY["tool result: denied by Ali"]
  GATE -- "deny" --> DENY
  EXEC --> MODEL
  DENY --> MODEL
  SAVE --> MEM["remember<br/>in the background (mem0)"] --> END(["Run done"])
