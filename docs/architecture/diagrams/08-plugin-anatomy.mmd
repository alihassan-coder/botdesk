flowchart LR
  subgraph PKG["One plugin = one package"]
    direction TB
    MAN["manifest.json (generated from code)<br/>id · version · runtime<br/>auth · permissions · settings"]
    TOOLS["tools<br/>input + output models<br/>risk class · egress · presenter"]
    TRIG["triggers<br/>e.g. new_email"]
    CODE["handlers<br/>Python, built-in tier only"]
  end
  REG["Registry<br/>finds plugins through<br/>entry points: botdesk.plugins<br/>loads only ids on the allowlist<br/>built once at startup"]
  subgraph CORE["BotDesk core"]
    direction TB
    SEAMS["Capability seams<br/>(Protocols in the plugin SDK)<br/>ToolProvider · TriggerSource<br/>AuthProvider · ModelProvider<br/>MemoryStore · Computer · Approver"]
    PIPE["Tool pipeline + policy engine<br/>risk comes from the manifest,<br/>so no code per plugin"]
  end
  PKG --> REG --> SEAMS --> PIPE
