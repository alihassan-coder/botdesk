flowchart LR
  MSG["New message"] --> RECALL["recall: search mem0<br/>scope = organization + bot<br/>top 5 relevant"]
  RECALL --> PROMPT["Added to the prompt:<br/>Things you remember about this team"]
  PROMPT --> REPLY["Bot replies"]
  REPLY --> REM["remember, in the background:<br/>mem0 pulls out facts<br/>e.g. Acme bills on the 1st"]
  REM --> STORE[("pgvector in Postgres<br/>user_id = org:ID<br/>agent_id = bot ID")]
  STORE --> RECALL
  REM --> AUDIT["memory_audit<br/>who, what, source message"]
  UI["Settings → Memory<br/>see · edit · delete"] --> STORE
