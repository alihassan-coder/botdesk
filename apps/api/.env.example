# BotDesk API settings. Copy to .env and fill in. Never commit .env.

# development | test | production  (production: HTTPS-only cookies, no /api/docs)
ENVIRONMENT=development

# Postgres connection string. For Neon: Dashboard → Connect → copy the URL (keep ?sslmode=require).
# Leave unset to use a local SQLite file (./botdesk.db), handy for a first run.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/botdesk?sslmode=require
# Bots replying needs Postgres for real use (on SQLite, run checkpoints are kept in memory).

# Optional: the direct (unpooled) address, used for run checkpoints and memory, which keep
# their own connections. Empty = DATABASE_URL. On Neon it's the URL without "-pooler" in the host.
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.neon.tech/botdesk?sslmode=require

# Optional: a SEPARATE Postgres database for the Postgres tests (they wipe it). Unset = those
# tests are skipped. On Neon: CREATE DATABASE botdesk_test; then use its direct address.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/botdesk_test?sslmode=require

# Encrypts the model provider keys organizations save in Settings → Models & keys.
# REQUIRED in production (the API won't start without it). In development an unset key falls back
# to a fixed, public development key, with a warning. Changing it later makes saved keys unreadable
# (people then add them again). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Bots. A bot's model is "provider:model"; bots without one use DEFAULT_MODEL_ID.
# Organizations add their own provider keys in Settings → Models & keys; those come first.
# The keys below are an instance-wide fallback (handy when you self-host for one team).
# With neither, a provider's bots answer with a stand-in reply (handy offline).
DEFAULT_MODEL_ID=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Custom (OpenAI-compatible) model servers: in production, addresses on private, loopback or
# link-local networks are refused (so nobody can make the API call your internal services).
# Set to true if your model server lives on your own network. Outside production they're allowed.
ALLOW_PRIVATE_MODEL_URLS=false

# Run limits: model steps per run, seconds per run, runs going at once per bot.
RUN_MAX_STEPS=25
RUN_MAX_SECONDS=900
BOT_MAX_RUNNING_RUNS=2

# Tools: the built-in plugins to load (comma-separated allowlist). "demo" has fake tools
# (notes, a fake outbox, an inbox with a prompt injection) to try approvals without accounts.
PLUGINS=demo
TOOL_TIMEOUT_SECONDS=30
# An approval nobody answers in this many hours counts as "no".
APPROVAL_EXPIRY_HOURS=72

# Memory (mem0 on pgvector, in the same database). Needs Postgres and OPENAI_API_KEY
# (mem0 uses OpenAI to pick facts and to embed them). Off by default.
MEMORY_ENABLED=false

# Web app origins allowed to call the API with cookies (comma-separated).
WEB_ORIGINS=http://localhost:3000

# Where the web app lives; invite links point here.
WEB_APP_URL=http://localhost:3000

# Sign-in sessions and invite links (days they stay valid).
SESSION_COOKIE_NAME=botdesk_session
SESSION_DAYS=30
INVITATION_DAYS=7

# Email (Brevo transactional API). Leave the key empty to only log emails (dev and tests).
# Key: Brevo → SMTP & API → API Keys → Generate a new API key.
# Sender: Brevo → Senders & Domains → add and verify the address below (better: verify your
# own domain with DKIM/DMARC, or mail from a Gmail address may land in spam).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=BotDesk
# How long a password reset link works.
PASSWORD_RESET_MINUTES=60
