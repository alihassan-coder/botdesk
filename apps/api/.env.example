# BotDesk API settings. Copy to .env and fill in. Never commit .env.

# development | test | production  (production: HTTPS-only cookies, no /api/docs)
# Set it on purpose: only an explicit development or test allows running without SECRET_KEY.
# Left unset, the API treats SECRET_KEY like production does (required, 32+ characters).
ENVIRONMENT=development

# Postgres connection string. For Neon: Dashboard → Connect → copy the URL (keep ?sslmode=require).
# Leave unset to use a local SQLite file (./botdesk.db), handy for a first run.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/botdesk?sslmode=require
# Bots replying needs Postgres for real use (on SQLite, jobs and run checkpoints are kept in
# memory, so a restart fails unfinished replies).

# Where background jobs (bot runs, approval expiry, timers) run. embedded: inside the API process.
# separate (Postgres only): the API only adds jobs; run `python -m src.worker` alongside it.
WORKER_MODE=embedded
# Jobs one worker runs at once.
WORKER_CONCURRENCY=10

# Optional: the direct (unpooled) address, used by the job queue, live events (LISTEN), run
# checkpoints and memory, which keep their own connections. Empty = DATABASE_URL. On Neon it's the URL without "-pooler" in the host.
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.neon.tech/botdesk?sslmode=require

# Optional: a SEPARATE Postgres database for the Postgres tests (they wipe it). Unset = those
# tests are skipped. On Neon: CREATE DATABASE botdesk_test; then use its direct address.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/botdesk_test?sslmode=require

# Encrypts the model provider keys organizations save in Settings → Models & keys.
# REQUIRED, at least 32 characters, unless ENVIRONMENT is development or test (the API won't
# start otherwise). In development/test an unset key falls back to a fixed, PUBLIC development
# key, with a warning. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Rotating SECRET_KEY: put the new one in SECRET_KEY and the old one here (comma-separate several).
# Saved keys stay readable and are re-encrypted with the new SECRET_KEY the next time they're
# saved. Remove the old one once every key has been saved again (or re-added).
# SECRET_KEY_OLD=

# Bots. A bot's model is "provider:model"; bots without one use DEFAULT_MODEL_ID.
# Organizations add their own provider keys in Settings → Models & keys; those come first.
# The keys below are an instance-wide fallback (handy when you self-host for one team).
# With neither, a provider's bots answer with a stand-in reply (handy offline).
DEFAULT_MODEL_ID=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Custom (OpenAI-compatible) model servers: addresses on private, loopback or link-local networks
# are refused everywhere by default (the SSRF guard), so nobody with an admin role can make the
# API call your internal services or cloud metadata (169.254.169.254).
# Set to true only where the model server lives on a network you trust, e.g. on your own machine
# to use Ollama at http://localhost:11434/v1 in development:
# ALLOW_PRIVATE_MODEL_URLS=true
ALLOW_PRIVATE_MODEL_URLS=false
# The same for MCP servers (Connect apps → MCP servers), as its own switch. Set to true in
# development to add an MCP server running on your machine (it still needs https).
ALLOW_PRIVATE_MCP_URLS=false

# Run limits: model steps per run, seconds per run, runs going at once per bot.
RUN_MAX_STEPS=25
RUN_MAX_SECONDS=900
BOT_MAX_RUNNING_RUNS=2
# Bots @mentioning bots: a person's message starts hop 0, each bot reply that mentions another
# bot one more. A mention past this many hops starts nothing; the chat shows why it stopped.
BOT_HOP_LIMIT=3
# Handoffs (ADR 0014): tasks one run may hand off over its whole life, open tasks per
# organization (a soft cap), and the minutes a task may take before it fails as timed out
# (waiting for an approval counts). Handoffs share BOT_HOP_LIMIT with mentions.
HANDOFF_MAX_TASKS_PER_RUN=5
HANDOFF_MAX_OPEN_TASKS_PER_ORG=20
HANDOFF_TIMEOUT_MINUTES=60

# Tools: the plugins to load (comma-separated allowlist of plugin ids). Installed plugins
# (`botdesk.plugins` entry points) not named here are never imported. "demo" has fake tools
# (notes, a fake outbox, an inbox with a prompt injection) to try approvals without accounts.
PLUGINS=demo,gmail
TOOL_TIMEOUT_SECONDS=30
# An approval nobody answers in this many hours expires and counts as "no" (checked every minute).
APPROVAL_EXPIRY_HOURS=72

# Memory (mem0 on pgvector, in the same database). Needs Postgres and OPENAI_API_KEY
# (mem0 uses OpenAI to pick facts and to embed them). Off by default.
MEMORY_ENABLED=false

# Web app origins allowed to call the API with cookies (comma-separated).
WEB_ORIGINS=http://localhost:3000

# Where the web app lives; invite links point here.
WEB_APP_URL=http://localhost:3000

# The API's public address (no trailing slash). Sign-in with apps (OAuth) sends people back to
# API_PUBLIC_URL/api/v1/oauth/callback, so behind a proxy use the public HTTPS name.
API_PUBLIC_URL=http://localhost:8000

# Sign in with Google (Gmail in Connect apps). Your own OAuth client, type "Web application",
# with the redirect URI API_PUBLIC_URL/api/v1/oauth/callback. Until both are set, Connect apps
# shows Gmail as "Not set up on this server". Guide: docs/self-hosting/google-oauth.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Tests only (ignored unless ENVIRONMENT=test): a fake Google and Gmail API, e.g. http://127.0.0.1:9100
# GOOGLE_OAUTH_BASE_URL=
# GMAIL_API_BASE_URL=

# Bots' cloud computers (ADR 0020). Each organization adds its own Orgo key in Settings →
# Computers; nothing here is needed for that. A running computer stops after this many minutes
# (at least 10) without a tool call, a take-over or someone watching (checked every minute), and its running
# time is recorded as usage at ORGO_PRICE_PER_HOUR dollars an hour (Orgo's list price for 2 vCPU, 8 GB).
COMPUTER_IDLE_MINUTES=20
ORGO_PRICE_PER_HOUR=0.055
# Development and tests only (ignored unless ENVIRONMENT is development or test): a fake Orgo,
# e.g. http://127.0.0.1:9200/api. Unset = https://www.orgo.ai/api.
# ORGO_BASE_URL=

# Sign-in sessions and invite links (days they stay valid).
SESSION_COOKIE_NAME=botdesk_session
SESSION_DAYS=30
INVITATION_DAYS=7

# Who may create an account:
#   open         anyone who can reach the server (each gets their own organization)
#   invite-only  only from an unused invite link, with the invited email (joins that organization)
#   closed       no new accounts; existing people still sign in and accept invites
# Internet-facing? Sign up the first owner while open, then switch to invite-only.
SIGNUP_MODE=open

# Proxies whose X-Forwarded-For is believed (IPs or CIDRs, comma-separated). Sign-in, sign-up and
# password-reset rate limits count per client address, so behind a reverse proxy list it here, or
# everyone shares the proxy's allowance. Anyone else's X-Forwarded-For is ignored.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Email (Brevo transactional API). Leave the key empty to only log emails (dev and tests).
# Key: Brevo → SMTP & API → API Keys → Generate a new API key.
# Sender: Brevo → Senders & Domains → add and verify the address below (better: verify your
# own domain with DKIM/DMARC, or mail from a Gmail address may land in spam).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=BotDesk
# How long a password reset link works.
PASSWORD_RESET_MINUTES=60
